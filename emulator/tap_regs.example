# plant model: three hisolar inverters (USB0, USB2, USB3 = phases 1-3) and the
# grid meter (USB1). Change the two variables to move the house.
var LOAD 0      # house load per phase, W
var PV 0        # PV power per inverter, W
# grid meter: 230 V, 50 Hz, ratios 1; power per phase = load + inverter grid power
USB1 0x0061 2300
USB1 0x0062 2300
USB1 0x0063 2300
USB1 0x0077 5000
USB1 0x008d 1
USB1 0x008e 1
USB1 0x0067 =$LOAD-USB0:4017
USB1 0x0068 =$LOAD-USB2:4017
USB1 0x0069 =$LOAD-USB3:4017
USB1 0x006a =$LOAD+$LOAD+$LOAD-USB0:4017-USB2:4017-USB3:4017
USB0 4018 50000
USB0 4042 4000
USB0 4035 300
USB0 4036 300
USB0 4037 300
USB0 4038 300
USB0 4039 300
USB0 4040 300
USB0 4030 2000
USB0 4032 =$PV
USB0 4017 =-:0x0fd8
USB0 4022 =-:0x0fd8-$PV
USB2 4018 50000
USB2 4042 4000
USB2 4035 300
USB2 4036 300
USB2 4037 300
USB2 4038 300
USB2 4039 300
USB2 4040 300
USB2 4030 2000
USB2 4032 =$PV
USB2 4017 =-:0x0fd8
USB2 4022 =-:0x0fd8-$PV
USB3 4018 50000
USB3 4042 4000
USB3 4035 300
USB3 4036 300
USB3 4037 300
USB3 4038 300
USB3 4039 300
USB3 4040 300
USB3 4030 2000
USB3 4032 =$PV
USB3 4017 =-:0x0fd8
USB3 4022 =-:0x0fd8-$PV
out /sandbox/bak_power =-USB0:4022-USB2:4022-USB3:4022   # W into the battery
USB0 4027 =$LOAD
USB2 4027 =$LOAD
USB3 4027 =$LOAD
