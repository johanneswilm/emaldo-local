[Unit]
Description=Emaldo emulator: stand-in MCU and inverter serial ports (logged)
# The configured app exits with "failed to create mcu sock" without /dev/ttymxc2
# and polls inverters / b-sensor with Modbus on /dev/ttyCH9344USB0-3.
Before=emaldo.service

[Service]
ExecStart=/usr/bin/python3 /sandbox/serial_tap.py /dev/ttymxc2 /dev/ttyCH9344USB0 /dev/ttyCH9344USB1 /dev/ttyCH9344USB2 /dev/ttyCH9344USB3 /dev/ttyCH9344USB4 /dev/ttyCH9344USB5 /dev/ttyCH9344USB6 /dev/ttyCH9344USB7
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
