[Unit]
Description=Emaldo emulator: websocket sink for the app's hermes spy feed
# Needs hermes_spy = "ws://127.0.0.1:18765/spy" in /root/config.toml.
# Decoded battery / b-sensor readings land in /sandbox/spy.out.
Before=emaldo.service

[Service]
ExecStart=/usr/bin/python3 /sandbox/ws_sink.py 18765
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
